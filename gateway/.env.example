NODE_ENV=development
PORT=5000

# One or more backend instances, comma-separated.
# A single entry today; add more here later to enable round-robin load balancing.
BACKEND_TARGETS=http://localhost:4000

DATABASE_URL=postgres://payledger:payledger@localhost:5432/payledger
REDIS_URL=redis://localhost:6379

OTP_TTL_SECONDS=600
SESSION_TTL_SECONDS=3600
